# =====================================================================
# VidPulse Production Environment Variables Configuration Template
# WARNING: NEVER commit actual passwords, secrets, or API keys to git.
# =====================================================================

# --- System & Deployment ---
PROJECT_NAME="VidPulse SaaS Platform"
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1
SECRET_KEY=generate_with_openssl_rand_hex_32_change_this_immediately
ALLOWED_ORIGINS=["https://app.vidpulse.ai","https://vidpulse.ai"]

# --- PostgreSQL Database ---
# Format: postgresql+asyncpg://user:password@host:5432/dbname
POSTGRES_USER=vidpulse_user
POSTGRES_PASSWORD=generate_a_secure_database_password
POSTGRES_DB=vidpulse_db
DATABASE_URL=postgresql+asyncpg://vidpulse_user:generate_a_secure_database_password@postgres:5432/vidpulse_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# --- Redis Caching & Rate Limiting ---
REDIS_URL=redis://redis:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=generate_jwt_secret_hex_64_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google & YouTube Integration ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://app.vidpulse.ai/api/v1/youtube/oauth/callback
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
GOOGLE_PROJECT_ID=your-google-cloud-project-id

# --- AI Models Engine ---
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
OLLAMA_BASE_URL=http://localhost:11434

# --- Billing & Subscriptions (Stripe) ---
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_BASIC_MONTHLY=price_basic_m_id
STRIPE_PRICE_PRO_MONTHLY=price_pro_m_id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_m_id

# --- Billing & Subscriptions (Razorpay) ---
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Monitoring & Error Tracking ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
PROMETHEUS_METRICS_ENABLED=true
