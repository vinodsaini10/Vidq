# VidPulse AI Backend Environment Configuration
PROJECT_NAME="VidPulse AI API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=false

SECRET_KEY="replace-this-with-a-secure-random-secret-key-32-chars-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL / Neon Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vidpulse_db

# Standard Local Connection:
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Neon Serverless PostgreSQL Connection Example:
# Paste your Neon connection string below (auto-converted to asyncpg with ssl=require):
DATABASE_URL=postgresql://alex:password123@ep-cool-river-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# AI Services Configuration
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OLLAMA_BASE_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=GEMINI
AI_DEFAULT_MODEL=gemini-3.6-flash
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2
AI_CACHE_TTL=3600
AI_ENABLE_FALLBACK=true

# Google OAuth 2.0 & YouTube API Configuration
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/youtube/oauth/callback"
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"
GOOGLE_PROJECT_ID="your-google-cloud-project-id"
GOOGLE_OAUTH_SCOPES='["https://www.googleapis.com/auth/youtube.readonly","https://www.googleapis.com/auth/yt-analytics.readonly","https://www.googleapis.com/auth/yt-analytics-monetary.readonly","https://www.googleapis.com/auth/youtube.force-ssl"]'

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.run.app"]

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@vidpulse.ai
EMAILS_FROM_NAME="VidPulse AI Team"

# Payment Gateways (Stripe & Razorpay)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_DEFAULT_INR=true
